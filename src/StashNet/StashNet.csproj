<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mod DLL that the game loads. Game DLLs are referenced from the local install and never copied. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>StashNet</AssemblyName>
    <RootNamespace>StashNet</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Staged mod folder: ModInfo.xml + Config + StashNet.dll -->
    <ModStageDir>$(MSBuildThisFileDirectory)..\..\dist\StashNet\</ModStageDir>
  </PropertyGroup>

  <!-- Compile against the GAME's own runtime libraries (Unity's mscorlib etc.), not the standard
       .NET Framework ones: the game's API uses types (e.g. ReadOnlySpan) that only exist there,
       and type identities must match what the game actually runs. -->
  <PropertyGroup>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoStandardLib>true</NoStandardLib>
  </PropertyGroup>

  <!-- The game's own framework libraries, added straight to the compiler in the target below
       (assembly resolution would otherwise swap them for the SDK's copies of the same names). -->
  <ItemGroup>
    <GameFrameworkLib Include="$(GameManaged)\mscorlib.dll;$(GameManaged)\System.dll;$(GameManaged)\System.Core.dll;$(GameManaged)\System.Xml.dll;$(GameManaged)\System.Xml.Linq.dll;$(GameManaged)\netstandard.dll" />
  </ItemGroup>

  <!-- Game-free logic is compiled straight into the mod so the game only loads one DLL. -->
  <ItemGroup>
    <Compile Include="..\StashNet.Core\**\*.cs" Exclude="..\StashNet.Core\obj\**;..\StashNet.Core\bin\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary"><HintPath>$(GameManaged)\LogLibrary.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\Mods\0_TFP_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The SDK still injects standard .NET Framework reference assemblies for net48. Drop them so
       only the game's own runtime libraries (referenced above) are compiled against. -->
  <Target Name="UseOnlyGameFrameworkLibraries" AfterTargets="ResolveAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="$([System.String]::Copy('%(ReferencePath.FullPath)').ToLowerInvariant().Contains('referenceassemblies'))" />
      <ReferencePath Include="@(GameFrameworkLib)" />
    </ItemGroup>
  </Target>

  <!-- After build: stage the mod folder, then copy it into the game's Mods folder. -->
  <Target Name="StageMod" AfterTargets="Build">
    <ItemGroup>
      <ModContent Include="$(MSBuildThisFileDirectory)..\..\Mod\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(ModStageDir)" />
    <Copy SourceFiles="@(ModContent)" DestinationFiles="@(ModContent->'$(ModStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModStageDir)" />
    <Message Importance="high" Text="StashNet staged at $(ModStageDir)" />
  </Target>

  <!-- Release zip (M9): add -p:Package=true to also write dist\StashNet-v<ModInfo version>.zip.
       It holds one StashNet\ folder (the staged mod + README.md) that players drop into their Mods folder. -->
  <Target Name="PackageMod" AfterTargets="StageMod" Condition="'$(Package)' == 'true'">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)..\..\Mod\ModInfo.xml" Query="/xml/Version/@value">
      <Output TaskParameter="Result" PropertyName="ModVersion" />
    </XmlPeek>
    <PropertyGroup>
      <PackageRoot>$(MSBuildThisFileDirectory)..\..\dist\package\</PackageRoot>
      <PackageZip>$(MSBuildThisFileDirectory)..\..\dist\StashNet-v$(ModVersion).zip</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(ModStageDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <Copy SourceFiles="@(PackageFiles)" DestinationFiles="@(PackageFiles->'$(PackageRoot)StashNet\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\README.md" DestinationFolder="$(PackageRoot)StashNet" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" />
    <RemoveDir Directories="$(PackageRoot)" />
    <Message Importance="high" Text="StashNet release zip: $(PackageZip)" />
  </Target>

  <Target Name="DeployMod" AfterTargets="StageMod" Condition="'$(Deploy)' == 'true'">
    <ItemGroup>
      <StagedFiles Include="$(ModStageDir)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(GameDir)\Mods\StashNet" />
    <Copy SourceFiles="@(StagedFiles)" DestinationFiles="@(StagedFiles->'$(GameDir)\Mods\StashNet\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="StashNet deployed to $(GameDir)\Mods\StashNet" />
  </Target>

</Project>
