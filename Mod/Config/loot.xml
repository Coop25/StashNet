<configs>
	<append xpath="/lootcontainers">
		<!-- Drive Bay slots per tier: 4, 8 (Reinforced), 12 (Armored). Player-owned storage: never generates loot. -->
		<lootcontainer name="stashnetDriveBaySlots" count="0" size="4,1" sound_open="UseActions/open_safe" sound_close="UseActions/close_safe" loot_quality_template="qualBaseTemplate">
		</lootcontainer>
		<lootcontainer name="stashnetDriveBaySlotsReinforced" count="0" size="4,2" sound_open="UseActions/open_safe" sound_close="UseActions/close_safe" loot_quality_template="qualBaseTemplate">
		</lootcontainer>
		<lootcontainer name="stashnetDriveBaySlotsArmored" count="0" size="4,3" sound_open="UseActions/open_safe" sound_close="UseActions/close_safe" loot_quality_template="qualBaseTemplate">
		</lootcontainer>
	</append>
</configs>
