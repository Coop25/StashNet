<configs>
	<append xpath="/blocks">

		<!-- ===== Cores =====
		     The network's brain. Holds the network's code (vanilla lock, M4). Bays and terminals have no
		     lock of their own; they ask their Core. A bay or terminal belongs to the NEAREST Core whose
		     StashNetRadius reaches it (M8).
		     Heat (M7/M8, Heat/TEFeatureStashNetHeat.cs): about every 167 s the server reports
		     min(total drive heat weight x StashNetHeatPerDrive, StashNetHeatCap). A Basic drive weighs 1.
		     Tiers (M8): Scrap 6 / 0.25, Storage 12 / 0.18, Advanced 24 / 0.12; cap 6.5 for all.
		     Upgrade in place with a hammer and the next tier's block: vanilla carries the lock code,
		     allowed players and owner over to the new block (GameManager.ChangeBlocks -> UpgradeDowngradeFrom).
		     Each tier is written out in full (no Extends) so no tier inherits another's UpgradeBlock. -->
		<block name="stashnetScrapCore">
			<property name="CreativeMode" value="Player" />
			<!-- A composite block (Blocks/BlockStashNetCore.cs) that also refuses placement within
			     2 x the largest Core reach of another Core (owner's spacing rule, 2026-11-13). -->
			<property name="Class" value="StashNet.Blocks.StashNetCore, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureLockable" />
				<property class="TEFeatureStashNetHeat" />
				<property class="TEFeatureStashNetArea" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<!-- Network reach in blocks (cube distance). Bays and Terminals within this range join. -->
			<property name="StashNetRadius" value="6" />
			<!-- Heat per heat weight (Basic drive = 1), and the most heat one report can be (placeholders, playtest). -->
			<property name="StashNetHeatPerDrive" value="0.25" />
			<property name="StashNetHeatCap" value="6.5" />
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Industrial/utilityElectricalBox_02Prefab.prefab" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="1000" />
			<property name="DescriptionKey" value="stashnetScrapCoreDesc" />
			<property class="RepairItems">
				<property name="resourceScrapIron" value="10" />
			</property>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="stashnetStorageCore" />
				<property name="Item" value="stashnetStorageCore" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<property name="UpgradeSound" value="place_block_metal" />
			<drop event="Destroy" name="resourceScrapIron" count="5,10" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0000" />
		</block>

		<!-- Storage Core (M8, tier 2): reach 12, runs cooler. -->
		<block name="stashnetStorageCore">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StashNet.Blocks.StashNetCore, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureLockable" />
				<property class="TEFeatureStashNetHeat" />
				<property class="TEFeatureStashNetArea" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<property name="StashNetRadius" value="12" />
			<property name="StashNetHeatPerDrive" value="0.18" />
			<property name="StashNetHeatCap" value="6.5" />
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Industrial/controlPanelBase_05Prefab.prefab" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="5000" />
			<property name="DescriptionKey" value="stashnetStorageCoreDesc" />
			<property class="RepairItems">
				<property name="resourceForgedIron" value="5" />
			</property>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="stashnetAdvancedCore" />
				<property name="Item" value="stashnetAdvancedCore" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<property name="UpgradeSound" value="place_block_metal" />
			<drop event="Destroy" name="resourceScrapIron" count="10,20" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0004" />
		</block>

		<!-- Advanced Storage Core (M8, tier 3): reach 24, runs coolest. Top tier: no upgrade. -->
		<block name="stashnetAdvancedCore">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StashNet.Blocks.StashNetCore, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureLockable" />
				<property class="TEFeatureStashNetHeat" />
				<property class="TEFeatureStashNetArea" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<property name="StashNetRadius" value="24" />
			<property name="StashNetHeatPerDrive" value="0.12" />
			<property name="StashNetHeatCap" value="6.5" />
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Industrial/controlPanelBase_01Prefab.prefab" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="10000" />
			<property name="DescriptionKey" value="stashnetAdvancedCoreDesc" />
			<property class="RepairItems">
				<property name="resourceForgedSteel" value="5" />
			</property>
			<drop event="Destroy" name="resourceScrapIron" count="15,30" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0005" />
		</block>

		<!-- ===== Drive Bays =====
		     Container that only accepts drives (Patches/DriveBayOnlyDrivesPatches.cs). Access follows the
		     network Core's lock (Blocks/TEFeatureStashNetDriveBay.cs, listed FIRST so its "network locked"
		     prompt wins). The bay's own TEFeatureLockable is kept only so bays placed before M4 keep
		     loading; its lock/keypad commands are disabled.
		     Tiers (M8): Drive Bay 4 slots / 1,000 HP, Reinforced 8 / 5,000, Armored 12 / 10,000 (hard cap).
		     Upgrade in place with a hammer and the next tier's block: vanilla moves the drives into the
		     new, bigger slot grid. A broken bay of any tier drops its drives in a loot bag (no downgrade).
		     Each tier is written out in full (no Extends). -->
		<block name="stashnetDriveBay">
			<property name="CreativeMode" value="Player" />
			<!-- Our subclass of CompositeTileEntity: same block, plus the salvage-look skin (Mod/Skins). -->
			<property name="Class" value="StashNet.Blocks.StashNetDriveBay, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureStashNetDriveBay" />
				<property class="TEFeatureStorage">
					<property name="LootList" value="stashnetDriveBaySlots" />
				</property>
				<property class="TEFeatureLockable" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/LootContainers/filecabinet_tall_closedPrefab.prefab" />
			<property name="DisplayType" value="blockMulti" />
			<property name="MultiBlockDim" value="1,2,1" />
			<property name="ModelOffset" value="0,0,0" />
			<!-- No CustomIcon: the game uses Mod/UIAtlases/ItemIconAtlas/stashnetDriveBay.png (tools/icons/draw-block-icons.ps1).
			     No TintColor: the salvage look is painted into the texture (Mod/Skins/paint.xml). -->
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="1000" />
			<property name="DescriptionKey" value="stashnetDriveBayDesc" />
			<property class="RepairItems">
				<property name="resourceScrapIron" value="8" />
			</property>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="stashnetDriveBayReinforced" />
				<property name="Item" value="stashnetDriveBayReinforced" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<property name="UpgradeSound" value="place_block_metal" />
			<drop event="Destroy" name="resourceScrapIron" count="4,8" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0001" />
		</block>

		<!-- Reinforced Drive Bay (M8, tier 2): 8 drives, about as tough as concrete. -->
		<block name="stashnetDriveBayReinforced">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StashNet.Blocks.StashNetDriveBay, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureStashNetDriveBay" />
				<property class="TEFeatureStorage">
					<property name="LootList" value="stashnetDriveBaySlotsReinforced" />
				</property>
				<property class="TEFeatureLockable" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Electrical/serverComputerPrefab.prefab" />
			<property name="DisplayType" value="blockMulti" />
			<property name="MultiBlockDim" value="1,2,1" />
			<property name="ModelOffset" value="0,0.5,0" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="5000" />
			<property name="DescriptionKey" value="stashnetDriveBayReinforcedDesc" />
			<property class="RepairItems">
				<property name="resourceForgedIron" value="5" />
			</property>
			<property class="UpgradeBlock">
				<property name="ToBlock" value="stashnetDriveBayArmored" />
				<property name="Item" value="stashnetDriveBayArmored" />
				<property name="ItemCount" value="1" />
				<property name="UpgradeHitCount" value="4" />
			</property>
			<property name="UpgradeSound" value="place_block_metal" />
			<drop event="Destroy" name="resourceScrapIron" count="8,16" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0006" />
		</block>

		<!-- Armored Drive Bay (M8, tier 3): 12 drives, about as tough as steel (hard cap). Top tier. -->
		<block name="stashnetDriveBayArmored">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StashNet.Blocks.StashNetDriveBay, StashNet" />
			<property class="CompositeFeatures">
				<property class="TEFeatureStashNetDriveBay" />
				<property class="TEFeatureStorage">
					<property name="LootList" value="stashnetDriveBaySlotsArmored" />
				</property>
				<property class="TEFeatureLockable" />
				<property class="TEFeaturePickup">
					<property name="TakeDelay" value="2" />
				</property>
			</property>
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/LootContainers/safeGunLargeFullPrefab.prefab" />
			<property name="DisplayType" value="blockMulti" />
			<property name="MultiBlockDim" value="1,2,1" />
			<property name="ModelOffset" value="0,0.5,0" />
			<!-- No TintColor: the darker army green is painted into the texture (Mod/Skins/paint.xml). -->
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="10000" />
			<property name="DescriptionKey" value="stashnetDriveBayArmoredDesc" />
			<property class="RepairItems">
				<property name="resourceForgedSteel" value="5" />
			</property>
			<drop event="Destroy" name="resourceScrapIron" count="12,24" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0007" />
		</block>

		<!-- Storage Terminal: browse the network (src/StashNet/Blocks/BlockStashNetTerminal.cs). -->
		<block name="stashnetTerminal">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="StashNet.Blocks.StashNetTerminal, StashNet" />
			<!-- Heat added while the terminal is in use, at most once per ~167 s (M7, placeholder). -->
			<property name="StashNetHeatOnUse" value="0.5" />
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<!-- The vanilla CRT TV, screen on (model of tvCRT_PlayerOn), 1x1x1. Owner's pick 2026-11-13; it was a
			     2-wide desktop PC before v0.10.1, so terminals placed earlier must be picked up before updating.
			     The green StashNet screen comes from the texture repaint (Mod/Skins). -->
			<property name="Model" value="@:Entities/Electrical/tvCRTPlayerOnPrefab.prefab" />
			<property name="ModelOffset" value="0,0,0" />
			<property name="GndAlign" value="1" />
			<property name="Collide" value="movement,melee,bullet,arrow,rocket" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="Path" value="solid" />
			<property name="MaxDamage" value="500" />
			<property name="CanPickup" value="true" />
			<property name="DescriptionKey" value="stashnetTerminalDesc" />
			<property class="RepairItems">
				<property name="resourceElectricParts" value="2" />
			</property>
			<drop event="Destroy" name="resourceElectricParts" count="1,3" />
			<property name="Group" value="Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_electrical" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0002" />
		</block>

		<!-- Crafting Terminal (M6): a vanilla workbench in every way (screen, recipes, perk gates, queue,
		     output) whose recipes can also use ingredients from the nearby StashNet network.
		     Hooks: src/StashNet/Crafting/. UnlockedBy is not inherited; the recipe needs a workbench anyway. -->
		<block name="stashnetCraftingTerminal">
			<property name="Extends" value="workbench" param1="UnlockedBy,DescriptionKey,CustomIcon,CustomIconTint,SortOrder1,SortOrder2,TraderStageTemplate" />
			<property name="StashNetCraftingTerminal" value="true" />
			<!-- Recipe category tabs: the vanilla station's list (ui_display.xml), see Crafting/StationCategoryPatch.cs. -->
			<property name="StashNetCategories" value="workbench" />
			<!-- Our subclass of the vanilla Workstation class (tracked by the skin code; no paint entry since 2026-11-16, so it looks vanilla). -->
			<property name="Class" value="StashNet.Blocks.StashNetCraftingTerminal, StashNet" />
			<!-- Do NOT set WorkstationName: the game files workstation data under it but looks it up by
			     block name, so the screen wouldn't open (v0.7.0 bug). Recipes come from the inherited
			     CraftingAreaRecipes="player,workbench"; the screen from WorkstationWindow. -->
			<property name="WorkstationWindow" value="workstation_workbench" />
			<property name="DescriptionKey" value="stashnetCraftingTerminalDesc" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0003" />
		</block>

		<!-- v0.19.0 (owner, 2026-11-14): StashNet versions of four vanilla stations. Same model, window,
		     recipes, fuel and heat; the StashNetCraftingTerminal marker makes them use network storage
		     exactly like the Crafting Terminal. Recipes for chem/campfire/mixer are matched by block name
		     in vanilla, so ours name the vanilla crafting area explicitly. -->
		<block name="stashnetForge">
			<property name="Extends" value="forge" param1="UnlockedBy,DescriptionKey,CustomIcon,CustomIconTint,SortOrder1,SortOrder2,TraderStageTemplate" />
			<property name="StashNetCraftingTerminal" value="true" />
			<!-- Recipe category tabs: the vanilla station's list (ui_display.xml), see Crafting/StationCategoryPatch.cs. -->
			<property name="StashNetCategories" value="forge" />
			<!-- Refill (Station tab): how much of the chosen fuel automation keeps in the fuel slots. -->
			<property name="StashNetFuelRefill" value="100" />
			<!-- Raw items automation may feed into the forge per metal, in priority order (melt targets, Stations/StationAutomation.cs). Nothing else is ever melted automatically. -->
			<property name="StashNetMeltFeed" value="iron:resourceScrapIron;brass:resourceScrapBrass;lead:resourceScrapLead;glass:resourceBrokenGlass,resourceCrushedSand;stone:resourceRockSmall;clay:resourceClayLump" />
			<!-- Ore slots automation may fill: the forge window shows 2 of the game's 3, so never the hidden 3rd (Stations/StationRules.OreSlots). -->
			<property name="StashNetOreSlots" value="2" />
			<property name="WorkstationWindow" value="workstation_forge" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="forge" />
			</property>
			<property name="DescriptionKey" value="stashnetForgeDesc" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0004" />
		</block>

		<block name="stashnetChemistryStation">
			<property name="Extends" value="chemistryStation" param1="UnlockedBy,DescriptionKey,CustomIcon,CustomIconTint,SortOrder1,SortOrder2,TraderStageTemplate" />
			<property name="StashNetCraftingTerminal" value="true" />
			<!-- Recipe category tabs: the vanilla station's list (ui_display.xml), see Crafting/StationCategoryPatch.cs. -->
			<property name="StashNetCategories" value="chemistryStation" />
			<!-- Refill (Station tab): how much of the chosen fuel automation keeps in the fuel slots. -->
			<property name="StashNetFuelRefill" value="100" />
			<property name="WorkstationWindow" value="workstation_chemistryStation" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="chemistryStation" />
			</property>
			<property name="DescriptionKey" value="stashnetChemistryStationDesc" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0005" />
		</block>

		<block name="stashnetCampfire">
			<property name="Extends" value="campfire" param1="UnlockedBy,DescriptionKey,CustomIcon,CustomIconTint,SortOrder1,SortOrder2,TraderStageTemplate" />
			<property name="StashNetCraftingTerminal" value="true" />
			<!-- Recipe category tabs: the vanilla station's list (ui_display.xml), see Crafting/StationCategoryPatch.cs. -->
			<property name="StashNetCategories" value="campfire" />
			<!-- Refill (Station tab): how much of the chosen fuel automation keeps in the fuel slots. -->
			<property name="StashNetFuelRefill" value="100" />
			<property name="WorkstationWindow" value="workstation_campfire" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="campfire" />
			</property>
			<property name="DescriptionKey" value="stashnetCampfireDesc" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0006" />
		</block>

		<block name="stashnetCementMixer">
			<property name="Extends" value="cementMixer" param1="UnlockedBy,DescriptionKey,CustomIcon,CustomIconTint,SortOrder1,SortOrder2,TraderStageTemplate" />
			<property name="StashNetCraftingTerminal" value="true" />
			<!-- Recipe category tabs: the vanilla station's list (ui_display.xml), see Crafting/StationCategoryPatch.cs. -->
			<property name="StashNetCategories" value="cementMixer" />
			<property name="WorkstationWindow" value="workstation_cementMixer" />
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="cementMixer" />
			</property>
			<property name="DescriptionKey" value="stashnetCementMixerDesc" />
			<property name="SortOrder1" value="B900" />
			<property name="SortOrder2" value="0007" />
		</block>

	</append>
</configs>
