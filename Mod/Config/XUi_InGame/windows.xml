<configs>
	<append xpath="/windows">

		<!-- Storage Terminal: 8x6 grid of network items, paged. Controller: src/StashNet/UI/XUiC_StashNetTerminal.cs -->
		<window name="stashnetTerminalWindow" width="486" height="508" panel="Left" cursor_area="true" controller="StashNet.UI.XUiC_StashNetTerminal, StashNet">
			<sprite depth="0" name="background" sprite="menu_empty" color="[darkGrey]" type="sliced" />
			<sprite depth="1" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />

			<rect name="header" height="43" depth="1">
				<sprite depth="1" name="headerbackground" sprite="ui_game_panel_header" />
				<sprite depth="3" name="windowIcon" style="icon32px" pivot="center" pos="21,-21" sprite="ui_game_symbol_loot_sack" />
				<label depth="2" name="title" pos="39,-6" width="360" height="32" font_size="30" text_key="stashnetTerminalTitle" />
				<button depth="3" name="btnDepositAll" sprite="ui_game_symbol_store_all_up" tooltip_key="stashnetDepositAllTip" pos="460,-22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
			</rect>

			<label depth="2" name="usage" pos="10,-50" width="466" height="24" font_size="20" text="{stashnet_usage}" />

			<grid depth="3" name="entries" pos="3,-78" rows="6" cols="8" cell_width="60" cell_height="60" repeat_content="true">
				<rect controller="StashNet.UI.XUiC_StashNetEntry, StashNet" width="58" height="58">
					<button depth="2" name="clickable" width="58" height="58" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" />
					<sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{stashnet_icon}" color="{stashnet_iconcolor}" pos="29,-27" pivot="center" width="46" height="46" visible="{stashnet_hasitem}" foregroundlayer="true" />
					<label depth="5" name="count" pos="2,-40" width="54" height="18" font_size="16" justify="right" text="{stashnet_count}" />
				</rect>
			</grid>

			<label depth="2" name="hover" pos="10,-446" width="300" height="26" font_size="20" text="{stashnet_hover}" />
			<button depth="3" name="btnPrev" pos="345,-459" width="32" height="28" pivot="center" sprite="ui_game_symbol_arrow_left" style="press, hover" sound="[paging_click]" />
			<label depth="2" name="page" pos="365,-447" width="60" height="26" font_size="20" justify="center" text="{stashnet_page}" />
			<button depth="3" name="btnNext" pos="445,-459" width="32" height="28" pivot="center" sprite="ui_game_symbol_arrow_right" style="press, hover" sound="[paging_click]" />

			<label depth="2" name="status" pos="10,-478" width="466" height="26" font_size="18" color="[lightGrey]" text="{stashnet_status}" />
		</window>

	</append>
</configs>
