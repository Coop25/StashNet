<configs>
	<append xpath="/windows">

		<!-- Storage Terminal: search + sort row, category tabs, 8x11 grid of network items, paged (mouse wheel or arrows). Height 874 = item info panel 392 + panel gap 9 + backpack content bottom 473, so it reaches the bottom of the inventory.
		     Controller: src/StashNet/UI/XUiC_StashNetTerminal.cs -->
		<window name="stashnetTerminalWindow" width="486" height="874" panel="Left" cursor_area="true" controller="StashNet.UI.XUiC_StashNetTerminal, StashNet">
			<sprite depth="0" name="background" sprite="menu_empty" color="[darkGrey]" type="sliced" />
			<sprite depth="1" name="border" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />

			<rect name="header" height="43" depth="1">
				<sprite depth="1" name="headerbackground" sprite="ui_game_panel_header" />
				<sprite depth="3" name="windowIcon" style="icon32px" pivot="center" pos="21,-21" sprite="ui_game_symbol_loot_sack" />
				<label depth="2" name="title" pos="39,-6" width="360" height="32" font_size="30" text_key="stashnetTerminalTitle" />
			</rect>

			<!-- Search + sort -->
			<sprite depth="2" name="searchIcon" sprite="ui_game_symbol_search" pos="10,-51" width="24" height="24" color="[lightGrey]" />
			<textfield depth="5" name="searchInput" pos="38,-48" width="250" height="30" search_field="true" clear_button="true" />
			<rect name="sortButton" depth="3" pos="300,-48" width="176" height="30">
				<button depth="3" name="btnSort" width="176" height="30" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" />
				<label depth="4" name="sortLabel" pos="0,-4" width="176" height="24" font_size="20" justify="center" text="{stashnet_sort}" />
			</rect>

			<!-- Category tabs (All + the game's own item categories, as in the backpack filter). 14 slots = All + the 13 vanilla trader categories. Filled in code.
			     category_icon has pivot="center": each 28 px icon is centered on its cell's corner, so x = 8 margin + 14 half icon = 22
			     (row spans x 8-478 of 486 with all 14 tabs). x=6 put half the first icon outside the window's left edge. -->
			<grid depth="3" name="categories" pos="22,-99" rows="1" cols="14" cell_width="34" cell_height="34" repeat_content="true" controller="CategoryList" allow_key_paging="false" hide_gamepad_callouts="true">
				<category_icon size="28" collider_scale="1" />
			</grid>

			<label depth="2" name="usage" pos="10,-116" width="466" height="24" font_size="20" text="{stashnet_usage}" />

			<grid depth="3" name="entries" pos="3,-142" rows="11" cols="8" cell_width="60" cell_height="60" repeat_content="true">
				<rect controller="StashNet.UI.XUiC_StashNetEntry, StashNet" width="58" height="58">
					<button depth="2" name="clickable" width="58" height="58" on_scroll="true" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" />
					<sprite depth="3" name="selectedBorder" sprite="menu_empty3px" color="[white]" type="sliced" fillcenter="false" width="58" height="58" visible="{stashnet_selected}" />
					<sprite depth="4" name="icon" atlas="ItemIconAtlas" sprite="{stashnet_icon}" color="{stashnet_iconcolor}" pos="29,-27" pivot="center" width="46" height="46" visible="{stashnet_hasitem}" foregroundlayer="true" />
					<!-- Count: bottom-right normally; top-right when the durability bar takes the bottom. -->
					<label depth="5" name="count" pos="2,-40" width="54" height="18" font_size="16" justify="right" effect="outline" text="{stashnet_count}" visible="{stashnet_nodurability}" />
					<label depth="5" name="countTop" pos="2,-2" width="54" height="18" font_size="16" justify="right" effect="outline" text="{stashnet_count}" visible="{stashnet_hasdurability}" />
					<!-- Corner symbol like backpack slots: read/known, modded, boosted, block type. -->
					<sprite depth="7" name="typeIcon" sprite="ui_game_symbol_{stashnet_typeicon}" color="{stashnet_typeicontint}" pos="2,-2" width="20" height="20" visible="{stashnet_hastypeicon}" foregroundlayer="true" />
					<!-- Durability bar colored by quality tier; red behind it when max durability is permanently lost (vanilla look). -->
					<sprite depth="5" name="durabilityBack" sprite="menu_empty2px" color="{stashnet_durabilitybackcolor}" type="sliced" pos="3,-47" width="52" height="8" visible="{stashnet_hasdurability}" />
					<filledsprite depth="6" name="durability" sprite="menu_empty2px" color="{stashnet_durabilitycolor}" fill="{stashnet_durabilityfill}" type="filled" pos="3,-47" width="52" height="8" visible="{stashnet_hasdurability}" />
				</rect>
			</grid>

			<label depth="2" name="hover" pos="10,-810" width="172" height="26" font_size="20" text="{stashnet_hover}" />
			<!-- Amount for the info panel's Take button (vanilla Counter, like the trader's buy count): arrows (hold to repeat), typing, max. -->
			<rect name="amount" depth="3" pos="200,-810" width="120" height="30" controller="Counter">
				<button depth="3" name="countDown" style="icon30px, press, held" pos="0,-13" sprite="ui_game_symbol_arrow_left" pivot="center" sound="[paging_click]" />
				<textfield name="count_input" depth="3" pos="16,0" width="50" height="28" character_limit="6" validation="integer" virtual_keyboard_prompt="vkPromptCount" />
				<button depth="3" name="countUp" style="icon30px, press, held" pos="80,-13" sprite="ui_game_symbol_arrow_right" pivot="center" sound="[paging_click]" />
				<button depth="3" name="countMax" style="icon30px, press" pos="108,-13" sprite="ui_game_symbol_arrow_max" pivot="center" sound="[paging_click]" />
			</rect>
			<button depth="3" name="btnPrev" pos="345,-823" width="32" height="28" pivot="center" sprite="ui_game_symbol_arrow_left" style="press, hover" sound="[paging_click]" />
			<label depth="2" name="page" pos="365,-811" width="60" height="26" font_size="20" justify="center" text="{stashnet_page}" />
			<button depth="3" name="btnNext" pos="445,-823" width="32" height="28" pivot="center" sprite="ui_game_symbol_arrow_right" style="press, hover" sound="[paging_click]" />

			<label depth="2" name="status" pos="10,-842" width="466" height="26" font_size="18" color="[lightGrey]" text="{stashnet_status}" />
		</window>

	</append>

	<!-- v0.22.1: two tabs of our own in the recipe box (vanilla craftingInfoPanel), after Ingredients / Description:
	     STOCK (lightning: keep in stock, keep melted, the list) and STATION (fire: finished items, fire, refill).
	     Only at Network stations (the controller hides the tab buttons elsewhere). At those stations the recipe
	     box also takes the empty info panel's place, so a tab opens without a selected recipe
	     (UI/AutomationTabPatches.cs). Controller: src/StashNet/UI/XUiC_StashNetAutomation.cs.
	     Choice backgrounds are sprites whose colour is bound (stashnet_sel_*), so the chosen one is highlighted.
	     The click buttons on top use alpha 3/255, never 0: NGUI ignores clicks on widgets with alpha < 0.001. -->
	<append xpath="/windows/window[@name='craftingInfoPanel']/rect[@name='contentCraftingInfo']">
		<rect name="stashnetAutomation" depth="2" pos="0,0" width="604" height="348" controller="StashNet.UI.XUiC_StashNetAutomation, StashNet">
			<button depth="5" name="btnAutomationTab" style="icon30px, press" pos="303,-22" sprite="ui_game_symbol_electric_power" pivot="center" tooltip_key="stashnetAutomationTab" sound="[paging_click]" visible="{stashnet_atstation}" />
			<button depth="5" name="btnStationTab" style="icon30px, press" pos="346,-22" sprite="ui_game_symbol_fire" pivot="center" tooltip_key="stashnetStationTab" sound="[paging_click]" visible="{stashnet_atstation}" />

			<rect depth="3" name="tabFrame" pos="153,-43" width="447" height="303" visible="{stashnet_tabopen}">
				<sprite depth="3" name="border" sprite="menu_empty3px" pos="-3,0" width="453" height="303" color="[black]" type="sliced" fillcenter="false" />
				<sprite depth="1" name="background" color="[darkGrey]" type="sliced" width="447" height="301" />
			</rect>

			<!-- ======== STOCK tab ======== -->
			<rect depth="3" name="stockContent" pos="153,-43" width="447" height="303" visible="{stashnet_stocktab}">
				<!-- Keep the selected recipe in stock. -->
				<label depth="4" name="keepLabel" pos="8,-9" width="236" height="26" font_size="20" text="{stashnet_keeplabel}" />
				<rect name="amount" depth="4" pos="248,-6" width="110" height="30" controller="Counter" visible="{stashnet_hasrecipe}">
					<button depth="4" name="countDown" style="icon30px, press, held" pos="0,-13" sprite="ui_game_symbol_arrow_left" pivot="center" sound="[paging_click]" />
					<textfield name="count_input" depth="4" pos="16,0" width="66" height="28" character_limit="7" validation="integer" virtual_keyboard_prompt="vkPromptCount" />
					<button depth="4" name="countUp" style="icon30px, press, held" pos="96,-13" sprite="ui_game_symbol_arrow_right" pivot="center" sound="[paging_click]" />
					<!-- The vanilla Counter requires countMax (v0.20.0 crash without it). Hidden: max would be 1,000,000. -->
					<button depth="4" name="countMax" style="icon30px, press" pos="96,-13" sprite="ui_game_symbol_arrow_max" pivot="center" visible="false" />
				</rect>
				<rect name="addRow" depth="4" pos="362,-6" width="80" height="30" visible="{stashnet_hasrecipe}">
					<button depth="4" name="btnAddRule" width="80" height="30" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip_key="stashnetAddRuleTip" />
					<label depth="5" name="addLabel" pos="0,-4" width="80" height="24" font_size="20" justify="center" text="{stashnet_addlabel}" />
				</rect>

				<!-- Forge: keep a metal melted at an amount. -->
				<rect name="meltRow" depth="4" pos="0,-38" width="447" height="32" visible="{stashnet_hasmelt}">
					<label depth="5" name="meltCaption" pos="8,-5" width="110" height="26" font_size="20" text_key="stashnetMeltLabel" />
					<button depth="5" name="btnMetalPrev" style="icon30px, press" pos="128,-15" sprite="ui_game_symbol_arrow_left" pivot="center" sound="[paging_click]" />
					<label depth="5" name="metalName" pos="142,-5" width="76" height="26" font_size="20" justify="center" text="{stashnet_metal}" />
					<button depth="5" name="btnMetalNext" style="icon30px, press" pos="232,-15" sprite="ui_game_symbol_arrow_right" pivot="center" sound="[paging_click]" />
					<rect name="meltAmount" depth="5" pos="248,-2" width="110" height="30" controller="Counter">
						<button depth="5" name="countDown" style="icon30px, press, held" pos="0,-13" sprite="ui_game_symbol_arrow_left" pivot="center" sound="[paging_click]" />
						<textfield name="count_input" depth="5" pos="16,0" width="66" height="28" character_limit="5" validation="integer" virtual_keyboard_prompt="vkPromptCount" />
						<button depth="5" name="countUp" style="icon30px, press, held" pos="96,-13" sprite="ui_game_symbol_arrow_right" pivot="center" sound="[paging_click]" />
						<button depth="5" name="countMax" style="icon30px, press" pos="96,-13" sprite="ui_game_symbol_arrow_max" pivot="center" visible="false" />
					</rect>
					<rect name="meltAddRow" depth="5" pos="362,-2" width="80" height="30">
						<button depth="5" name="btnAddMelt" width="80" height="30" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip_key="stashnetAddMeltTip" />
						<label depth="6" name="meltAddLabel" pos="0,-4" width="80" height="24" font_size="20" justify="center" text="{stashnet_meltaddlabel}" />
					</rect>
				</rect>

				<!-- What this station keeps: stock rules, then melt targets (10 per page). -->
				<label depth="4" name="keptHeader" pos="8,-74" width="330" height="22" font_size="18" color="[lightGrey]" text_key="stashnetKeptHere" />
				<button depth="4" name="btnPagePrev" style="icon30px, press" pos="372,-84" sprite="ui_game_symbol_arrow_left" pivot="center" sound="[paging_click]" visible="{stashnet_paging}" />
				<label depth="4" name="pageLabel" pos="384,-74" width="44" height="22" font_size="16" justify="center" color="[lightGrey]" text="{stashnet_page}" visible="{stashnet_paging}" />
				<button depth="4" name="btnPageNext" style="icon30px, press" pos="438,-84" sprite="ui_game_symbol_arrow_right" pivot="center" sound="[paging_click]" visible="{stashnet_paging}" />
				<label depth="4" name="noRules" pos="16,-98" width="420" height="22" font_size="18" color="[lightGrey]" text_key="stashnetNoRules" visible="{stashnet_norules}" />
				<grid depth="4" name="rules" pos="4,-96" rows="10" cols="1" cell_width="439" cell_height="20" repeat_content="true">
					<rect controller="StashNet.UI.XUiC_StashNetRuleRow, StashNet" width="439" height="20">
						<label depth="5" name="ruleText" pos="12,-1" width="400" height="19" font_size="18" color="{stashnet_rulecolor}" text="{stashnet_rule}" visible="{stashnet_hasrule}" />
						<button depth="5" name="btnRemove" pos="425,-10" width="18" height="18" pivot="center" sprite="ui_game_symbol_x" defaultcolor="[lightGrey]" hovercolor="[white]" style="press, hover" sound="[paging_click]" tooltip_key="stashnetRemoveRuleTip" visible="{stashnet_hasrule}" />
					</rect>
				</grid>
			</rect>

			<!-- ======== STATION tab ======== -->
			<rect depth="3" name="stationContent" pos="153,-43" width="447" height="303" visible="{stashnet_stationtab}">
				<!-- Finished items: to storage / stay here (every Network station). -->
				<label depth="5" name="outputCaption" pos="8,-11" width="150" height="24" font_size="20" text_key="stashnetOutputLabel" />
				<rect name="outputOn" depth="5" pos="160,-10" width="136" height="26">
					<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="136" height="26" color="{stashnet_sel_outon}" />
					<button depth="6" name="btnOutputOn" width="136" height="26" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip_key="stashnetOutputOnTip" />
					<label depth="7" name="lbl" pos="0,-2" width="136" height="24" font_size="18" justify="center" text_key="stashnetOutputOn" />
				</rect>
				<rect name="outputOff" depth="5" pos="302,-10" width="136" height="26">
					<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="136" height="26" color="{stashnet_sel_outoff}" />
					<button depth="6" name="btnOutputOff" width="136" height="26" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip_key="stashnetOutputOffTip" />
					<label depth="7" name="lbl" pos="0,-2" width="136" height="24" font_size="18" justify="center" text_key="stashnetOutputOff" />
				</rect>
				<label depth="5" name="outputTip" pos="8,-40" width="432" height="20" font_size="16" color="[lightGrey]" text="{stashnet_outputtip}" />

				<!-- Fire: Myself / Auto (fuel stations), with what the current choice does. -->
				<rect name="fireRow" depth="4" pos="0,-74" width="447" height="60" visible="{stashnet_hasfuel}">
					<label depth="5" name="fireCaption" pos="8,-1" width="80" height="24" font_size="20" text_key="stashnetFireLabel" />
					<rect name="fireMyself" depth="5" pos="160,0" width="136" height="26">
						<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="136" height="26" color="{stashnet_sel_myself}" />
						<button depth="6" name="btnFireMyself" width="136" height="26" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" />
						<label depth="7" name="lbl" pos="0,-2" width="136" height="24" font_size="18" justify="center" text_key="stashnetFireMyself" />
					</rect>
					<rect name="fireAuto" depth="5" pos="302,0" width="136" height="26">
						<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="136" height="26" color="{stashnet_sel_auto}" />
						<button depth="6" name="btnFireAuto" width="136" height="26" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" />
						<label depth="7" name="lbl" pos="0,-2" width="136" height="24" font_size="18" justify="center" text_key="stashnetFireAuto" />
					</rect>
					<label depth="5" name="fireTip" pos="8,-30" width="432" height="30" font_size="16" color="[lightGrey]" text="{stashnet_firetip}" />
				</rect>

				<!-- Refill from storage (Fire = Auto): none, or one of the fuels in storage (icon + count), 2 rows. -->
				<rect name="refillRow" depth="4" pos="0,-140" width="447" height="70" visible="{stashnet_showrefill}">
					<label depth="5" name="refillCaption" pos="8,-5" width="80" height="24" font_size="20" text_key="stashnetRefillLabel" />
					<rect name="refillNone" depth="5" pos="92,-2" width="50" height="30">
						<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="50" height="30" color="{stashnet_sel_none}" />
						<button depth="6" name="btnRefillNone" width="50" height="30" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip_key="stashnetRefillNoneTip" />
						<label depth="7" name="lbl" pos="0,-4" width="50" height="24" font_size="18" justify="center" text_key="stashnetRefillNone" />
					</rect>
					<grid depth="5" name="fuels" pos="148,-2" rows="2" cols="7" cell_width="42" cell_height="34" repeat_content="true">
						<rect controller="StashNet.UI.XUiC_StashNetFuelChoice, StashNet" width="40" height="30">
							<sprite depth="5" name="bg" sprite="menu_empty" type="sliced" width="40" height="30" color="{stashnet_fuelbg}" visible="{stashnet_hasfuelitem}" />
							<sprite depth="6" name="icon" atlas="ItemIconAtlas" sprite="{stashnet_fuelicon}" color="{stashnet_fueliconcolor}" pos="6,-1" width="28" height="28" foregroundlayer="true" visible="{stashnet_hasfuelitem}" />
							<label depth="7" name="count" pos="0,-16" width="38" height="14" font_size="13" justify="right" effect="outline" text="{stashnet_fuelcount}" visible="{stashnet_hasfuelitem}" />
							<button depth="8" name="btnFuel" width="40" height="30" sprite="menu_empty" defaultcolor="0,0,0,3" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" tooltip="{stashnet_fuelname}" visible="{stashnet_hasfuelitem}" />
						</rect>
					</grid>
				</rect>
			</rect>
		</rect>
	</append>

</configs>
