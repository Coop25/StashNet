<?xml version="1.0" encoding="UTF-8"?>
<!-- StashNet "wrecked but working" repaint. At runtime the mod copies each block's vanilla texture (named
     below exactly as the game names it; see "sn skin dump") and repaints the copy, for StashNet blocks only:
       tint      army-green base paint (hex RRGGBB); strength 0..1 = how much of the vanilla color is replaced
       damage    how much scattered wear: grime, rust, scorch, bullet holes, claw gouges, bare metal (1 = normal)
       seed      changes where the damage lands
       holes     "false" = bullet hits are dents, never holes (armor)
       mask      0 (default) turns off the game's tint mask so the paint shows on every part; "keep" leaves it
       <stamp sprite u v w h rot flat>  one atlas sprite painted in (flat="true" also smooths the surface bumps under it): u,v = its center in the texture (0..1, from the
                 bottom-left), w,h = its size as a fraction of the texture, rot = degrees counter-clockwise.
     screen="sprite" replaces the picture on a screen part (the CRT TV). mute="true" silences the model's own sounds.
     Tune in-game: edit Mods/StashNet/Skins/paint.xml, then F1 "sn skin reload". "sn skin grid" shows a lettered
     grid instead, to find where each face is (columns A-H left to right, rows 1-8 from the top of the texture).
     Grid cell to u,v: column A..H = u 0.0625..0.9375 (center), row 1..8 = v 0.9375..0.0625 (center).
     Fronts found with the grid (owner, 2026-11-13): file cabinet drawers around the C3/D4 corner (all four
     drawers share it); gun safe C5-D8 rotated 180; server rack A4-D5 rotated 90; control panel A7-C8;
     electrical box front strip E2-G2 (its top is mirrored); TV bezel E3-G3; workbench drawer D2.
     Style rule (owner): when in doubt, dirtier and more worn. -->
<paint>
  <!-- Drive Bays: file cabinet (blue), server rack (green), gun safe (purple, darker green, dented not holed). -->
  <block name="stashnetDriveBay">
    <texture name="FileCabinet_d" tint="4A503F" strength="0.6" damage="1.2" seed="11">
      <!-- Drawer fronts (owner's test pattern, 2026-11-13): each drawer has its own spot, all upside down (rot 180;
           the top of a drawer is the lower v). Top drawer ~(0.60, 0.62), 2nd ~(0.48, 0.74), 3rd ~(0.48, 0.62), bottom ~(0.35, 0.74). -->
      <stamp sprite="stencilStashnet" u="0.6" v="0.655" w="0.1" h="0.02" rot="180" />
      <!-- Electronics (owner, 2026-11-13): drive lights on the 2nd drawer, a vent on the 3rd, ports on the bottom. -->
      <stamp sprite="ledPanel" u="0.484" v="0.755" w="0.075" h="0.036" rot="180" />
      <stamp sprite="ventGrille" u="0.484" v="0.64" w="0.085" h="0.04" rot="180" />
      <stamp sprite="portPanel" u="0.35" v="0.738" w="0.08" h="0.028" rot="180" />
      <stamp sprite="stripeBlue" u="0.35" v="0.765" w="0.12" h="0.015" rot="180" />
    </texture>
  </block>
  <block name="stashnetDriveBayReinforced">
    <!-- The rack's metal: paint and damage only; its marks go on the glass window (owner, 2026-11-13). -->
    <texture name="serverComputer" tint="4A503F" strength="0.6" damage="1.2" seed="12" />
    <!-- The window (shader Game/Transparent, texture GlassDirty_d): solid stamps so they aren't see-through.
         Owner's glyph test (2026-11-13): the glass shows only the LEFT half of the texture, the right way up:
         columns A-D (u ~0.04 to ~0.46), all rows 1-8 (v 0 to 1). So center marks at u 0.25. -->
    <texture name="GlassDirty_d" tint="4A503F" strength="0" damage="0" seed="14" solid="true">
      <stamp sprite="stencilStashnet" u="0.25" v="0.86" w="0.34" h="0.045" />
      <stamp sprite="stripeGreen" u="0.25" v="0.16" w="0.38" h="0.025" />
    </texture>
  </block>
  <block name="stashnetDriveBayArmored">
    <texture name="safeGunLarge" tint="3A3F31" strength="0.65" damage="1.0" seed="13" holes="false">
      <!-- Door front C5-D8, upside down on the texture (rot 180; the top of the door is v 0, its bottom v 0.5,
           and the door's right side is the lower u). Owner (2026-11-13): hide the safe maker's livery and make it
           look like it holds drives and electronics. -->
      <!-- Paint over the maker's logo, the corner flourishes and the decorative frame lines. -->
      <stamp sprite="paintPatch" u="0.374" v="0.123" w="0.18" h="0.105" rot="180" flat="true" />
      <stamp sprite="paintPatch" u="0.458" v="0.045" w="0.05" h="0.045" rot="180" flat="true" />
      <stamp sprite="paintPatch" u="0.3" v="0.045" w="0.05" h="0.045" rot="180" flat="true" />
      <stamp sprite="paintPatch" u="0.4815" v="0.246" w="0.022" h="0.47" rot="180" />
      <stamp sprite="paintPatch" u="0.3185" v="0.246" w="0.022" h="0.47" rot="180" />
      <stamp sprite="paintPatch" u="0.4" v="0.017" w="0.185" h="0.02" rot="180" />
      <stamp sprite="paintPatch" u="0.4" v="0.476" w="0.185" h="0.02" rot="180" />
      <stamp sprite="stencilStashnet" u="0.375" v="0.07" w="0.2" h="0.032" rot="180" />
      <stamp sprite="ledPanel" u="0.41" v="0.25" w="0.1" h="0.05" rot="180" />
      <stamp sprite="warningLabel" u="0.315" v="0.25" w="0.085" h="0.031" rot="180" />
      <stamp sprite="ventGrille" u="0.375" v="0.335" w="0.16" h="0.065" rot="180" />
      <stamp sprite="portPanel" u="0.375" v="0.395" w="0.13" h="0.045" rot="180" />
      <stamp sprite="stripePurple" u="0.375" v="0.43" w="0.24" h="0.018" rot="180" />
      <!-- Back A5-B8, also upside down (owner's grid shot, 2026-11-13): two big vents. -->
      <stamp sprite="ventGrille" u="0.125" v="0.14" w="0.19" h="0.09" rot="180" />
      <stamp sprite="ventGrille" u="0.125" v="0.36" w="0.19" h="0.09" rot="180" />
    </texture>
  </block>

  <!-- Cores: electrical box (blue), control panel 05 (green), control panel 01 (purple). -->
  <block name="stashnetScrapCore">
    <!-- Every face of this model is mirrored (owner's grid shots, 2026-11-13): front A-C rows 6-8 with the
         seam at column C (u 0.3125), lid top F-H rows 3-4 mirrored around H, sides F-G. Words would read
         backwards on one half, so symbols only, placed on the left half and mirrored into matching pairs. -->
    <texture name="utilityElectricalBox_02" tint="4A503F" strength="0.85" damage="1.7" seed="21">
      <!-- Owner's pick (2026-11-13, "C"): a Core, not a server. One glowing core emblem (its left half sits
           against the seam, the mirror completes it), hazard bands, heavy cables running into the ground. -->
      <stamp sprite="cableRun" u="0.05" v="0.19" w="0.05" h="0.36" />
      <stamp sprite="hazardBand" u="0.156" v="0.02" w="0.3125" h="0.03" />
      <stamp sprite="stripeBlue" u="0.156" v="0.055" w="0.3125" h="0.018" />
      <stamp sprite="coreHalfBlue" u="0.2675" v="0.2" w="0.09" h="0.18" />
      <stamp sprite="hazardBand" u="0.156" v="0.53" w="0.3125" h="0.035" />
    </texture>
  </block>
  <block name="stashnetStorageCore">
    <!-- Owner (2026-11-13): the transformer looked jarring, so this is now controlPanelBase05 (same texture as the
         Advanced Core, each gets its own copy). Grid shot: front A7-C8 the right way up (u 0-0.375, v 0-0.25),
         sloped top with lights and buttons A5-C6 (left vanilla). Whole core emblem = the half sprite plus the
         same half rotated 180 (the hexagon is symmetric top to bottom). -->
    <texture name="controlPanelControls" tint="4A503F" strength="0.6" damage="1.3" seed="22">
      <!-- Name on the sloped panel, under the two buttons (owner: higher and bigger; buttons end ~v 0.30). -->
      <stamp sprite="stencilStashnet" u="0.1875" v="0.274" w="0.32" h="0.045" />
      <stamp sprite="coreHalfGreen" u="0.165" v="0.11" w="0.045" h="0.09" />
      <stamp sprite="coreHalfGreen" u="0.21" v="0.11" w="0.045" h="0.09" rot="180" />
      <stamp sprite="stripeGreen" u="0.1875" v="0.03" w="0.34" h="0.016" />
    </texture>
  </block>
  <block name="stashnetAdvancedCore">
    <texture name="controlPanelControls" tint="4A503F" strength="0.55" damage="1.0" seed="23">
      <!-- Front A7-C8. -->
      <stamp sprite="stencilStashnet" u="0.19" v="0.215" w="0.22" h="0.034" />
      <stamp sprite="coreHalfPurple" u="0.0975" v="0.11" w="0.045" h="0.09" />
      <stamp sprite="coreHalfPurple" u="0.1425" v="0.11" w="0.045" h="0.09" rot="180" />
      <stamp sprite="readoutCore" u="0.29" v="0.11" w="0.09" h="0.032" />
      <stamp sprite="stripePurple" u="0.19" v="0.035" w="0.36" h="0.016" />
    </texture>
  </block>

  <!-- Storage Terminal: the CRT TV, with the green StashNet screen, silenced. -->
  <block name="stashnetTerminal" screen="crtScreen" mute="true" live="true" glitchMin="4" glitchMax="15" glitchLength="0.4" glitchStrength="0.6">
    <texture name="tvCRT" tint="4A503F" strength="0.5" damage="1.0" seed="31">
      <!-- Bezel above the screen, E3-G3. -->
      <stamp sprite="stencilStashnet" u="0.69" v="0.69" w="0.2" h="0.03" />
    </texture>
  </block>

  <!-- Network Workbench (stashnetCraftingTerminal): no skin, plain vanilla workbench look (owner, 2026-11-16). -->
</paint>
