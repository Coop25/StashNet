<?xml version="1.0" encoding="UTF-8"?>
<!-- StashNet "wrecked but working" decals, placed on each block's vanilla model at runtime.
     Sprites come from stashnet-skin.png (index: atlas.xml, drawn by tools/skin/draw-skin-atlas.ps1).
     Tune in-game: edit this file in Mods/StashNet/Skins, then run "sn skin reload" (F1). No restart needed.

     <skins shader="..." glowShader="...">  optional shader names that override the automatic pick.
     <block name front>                     front: which model-local axis the player sees as the front (+x, -x, +z, -z).
     <piece sprite face u v w h rot glow>   face: front|back|left|right|top (left/right as seen facing the front).
         u, v: piece center as a 0..1 fraction across the face (u=0 viewer's left edge, v=0 bottom edge; on top,
               v=0 is the front edge). w, h: size in meters. rot: degrees, counter-clockwise. glow: screens.
     Later pieces draw on top of earlier ones. Style rule: when in doubt, dirtier and more worn. -->
<skins>
  <!-- Drive Bay (tier 1, blue): tall file cabinet. -->
  <block name="stashnetDriveBay" front="-z">
    <piece sprite="bareMetal1" face="front" u="0.12" v="0.95" w="0.18" h="0.12" />
    <piece sprite="bareMetal2" face="front" u="0.92" v="0.55" w="0.12" h="0.18" />
    <piece sprite="scorch1" face="front" u="0.70" v="0.86" w="0.30" h="0.22" />
    <piece sprite="scorch2" face="front" u="0.30" v="0.12" w="0.26" h="0.20" />
    <piece sprite="rustStreak1" face="front" u="0.25" v="0.62" w="0.06" h="0.40" />
    <piece sprite="rustStreak2" face="front" u="0.80" v="0.22" w="0.07" h="0.50" />
    <piece sprite="rustBase" face="front" u="0.5" v="0.03" w="0.62" h="0.10" />
    <piece sprite="clawGouge" face="front" u="0.30" v="0.55" w="0.22" h="0.34" rot="15" />
    <piece sprite="bulletHole1" face="front" u="0.72" v="0.60" w="0.05" h="0.05" />
    <piece sprite="bulletHole2" face="front" u="0.80" v="0.54" w="0.05" h="0.05" rot="40" />
    <piece sprite="bulletHole1" face="front" u="0.33" v="0.18" w="0.05" h="0.05" rot="120" />
    <piece sprite="stencilStashnet" face="front" u="0.5" v="0.91" w="0.40" h="0.07" />
    <piece sprite="labelUnitBay" face="front" u="0.5" v="0.86" w="0.30" h="0.04" />
    <piece sprite="stripeBlue" face="front" u="0.5" v="0.27" w="0.62" h="0.05" />
    <piece sprite="readoutDrv4" face="front" u="0.5" v="0.76" w="0.30" h="0.11" glow="true" />
    <piece sprite="conduit" face="right" u="0.5" v="0.5" w="0.05" h="1.6" />
    <piece sprite="wireSpark" face="right" u="0.6" v="0.45" w="0.18" h="0.14" />
  </block>
</skins>
